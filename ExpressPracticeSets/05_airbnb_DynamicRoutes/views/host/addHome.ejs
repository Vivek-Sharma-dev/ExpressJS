<%- include('../includes/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <!-- Header/Navbar -->
    <%- include('../includes/nav') %>

    <!-- Main Content -->
    <main class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Form Container -->
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <!-- Gradient Header -->
        <div class="h-32 bg-linear-to-r from-red-500 to-red-600 flex items-center justify-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white">Add Your Property</h2>
        </div>

        <!-- Form Section -->
        <div class="p-8 md:p-12">
          <p class="text-gray-600 mb-8 text-lg">Fill in the details below to list your property on our platform.</p>
          
          <form action="/host/add-home" method="POST" class="space-y-6">
            <!-- Home Name Input -->
            <div>
              <label for="homeName" class="block text-sm font-semibold text-gray-900 mb-2">
                Property Name
              </label>
              <input
                type="text"
                id="homeName"
                name="homeName"
                placeholder="e.g., Cozy Beach House, Modern Apartment"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-200 placeholder-gray-400"
                required
              />
              <p class="text-gray-500 text-sm mt-2">Enter a descriptive name for your property</p>
            </div>

            <!-- per night price Input -->
            <div>
              <label for="price" class="block text-sm font-semibold text-gray-900 mb-2">
                Price per Night
              </label>
              <input
                type="text"
                id="price"
                name="price"
                placeholder="e.g., $100"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-200 placeholder-gray-400"
                required
              />
              <p class="text-gray-500 text-sm mt-2">Enter the price for your property per night</p>
            </div>
            <!-- Location Input -->
            <div>
              <label for="location" class="block text-sm font-semibold text-gray-900 mb-2">
                Property Location
              </label>
              <input
                type="text"
                id="location"
                name="location"
                placeholder="e.g., Miami, Florida"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-200 placeholder-gray-400"
              />
              <p class="text-gray-500 text-sm mt-2">Enter the location of your property</p>
            </div>
               <!-- Property Rating Input -->
            <div>
              <label for="rating" class="block text-sm font-semibold text-gray-900 mb-2">
                Property Rating
              </label>
              <input
                type="text"
                id="rating"
                name="rating"
                placeholder="e.g., 4.5"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-200 placeholder-gray-400"
                required
              />
              <p class="text-gray-500 text-sm mt-2">Enter the rating for your property</p>
            </div>

            <!-- Property image -->
            <div>
              <label for="image" class="block text-sm font-semibold text-gray-900 mb-2">
                Property Image
              </label>
              <input
                type="text"
                id="image"
                name="image"
                placeholder="e.g., https://example.com/image.jpg"
                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-200 transition-all duration-200 placeholder-gray-400"
                required
              />
              <p class="text-gray-500 text-sm mt-2">Enter the URL for your property's image</p>
            </div>

            <!-- Submit Button -->
            <div class="pt-4">
              <button 
                type="submit" 
                class="w-full py-3 px-6 bg-linear-to-r from-red-500 to-red-600 text-white font-bold rounded-lg hover:from-red-600 hover:to-red-700 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:scale-105"
              >
                List My Property
              </button>
            </div>

            <!-- Cancel Link -->
            <div class="text-center">
              <a href="/" class="text-gray-600 hover:text-red-600 font-medium transition-colors duration-200">
                Cancel and go back
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Info Cards -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-3xl mb-3">🏠</div>
          <h3 class="font-bold text-gray-900 mb-2">Easy Setup</h3>
          <p class="text-gray-600 text-sm">Add your property in just one step</p>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-3xl mb-3">👥</div>
          <h3 class="font-bold text-gray-900 mb-2">Find Guests</h3>
          <p class="text-gray-600 text-sm">Connect with travelers worldwide</p>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-3xl mb-3">💰</div>
          <h3 class="font-bold text-gray-900 mb-2">Earn Income</h3>
          <p class="text-gray-600 text-sm">Start earning from your property</p>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../includes/footer') %>
  </body>
</html>
