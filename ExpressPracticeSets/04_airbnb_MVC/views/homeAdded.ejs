<%- include('includes/head') %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">
    <!-- Header/Navbar -->
   <%- include('includes/nav') %>

    <!-- Main Content -->
    <main class="flex-1 max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <!-- Success Icon and Message -->
        <div class="bg-linear-to-r from-green-500 to-emerald-600 py-12 px-6 text-center">
          <div class="inline-flex items-center justify-center w-24 h-24 bg-white rounded-full mb-6 shadow-lg">
            <span class="text-5xl">✓</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-2">Success!</h2>
          <p class="text-green-100 text-lg">Your home has been added successfully</p>
        </div>

        <!-- Content Section -->
        <div class="p-8 md:p-12 text-center">
          <p class="text-gray-600 text-lg mb-8">
            Congratulations! Your property is now listed on our platform and ready to receive bookings from travelers around the world.
          </p>

          <!-- Action Buttons -->
          <div class="space-y-4 sm:space-y-0 sm:flex sm:gap-4 sm:justify-center">
            <a 
              href="/" 
              class="inline-flex items-center justify-center px-8 py-3 bg-red-600 text-white font-bold rounded-lg hover:bg-red-700 transition-all duration-200 shadow-lg hover:shadow-xl"
            >
              Go Back Home
            </a>
            <a 
              href="/host/add-home" 
              class="inline-flex items-center justify-center px-8 py-3 bg-gray-100 text-gray-800 font-bold rounded-lg hover:bg-gray-200 transition-all duration-200"
            >
              Add Another Property
            </a>
          </div>
        </div>
      </div>

      <!-- Info Box -->
      <div class="mt-10 bg-blue-50 border-l-4 border-blue-500 p-6 rounded-r-lg">
        <div class="flex gap-4">
          <div class="text-2xl">ℹ️</div>
          <div>
            <h3 class="font-bold text-blue-900 mb-2">What's Next?</h3>
            <ul class="text-blue-800 space-y-2 text-sm">
              <li>✓ Your property is now visible to potential guests</li>
              <li>✓ You can manage bookings from your dashboard</li>
              <li>✓ Update your property details anytime</li>
              <li>✓ Start earning from your property</li>
            </ul>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
      =<%- include('includes/footer') %>
</body>
</html>