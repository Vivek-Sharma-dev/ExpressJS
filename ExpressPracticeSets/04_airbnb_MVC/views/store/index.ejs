<%- include('../includes/head') %>
<style>
  @keyframes card-hover {
    0% {
      transform: translateY(0px);
    }
    100% {
      transform: translateY(-8px);
    }
  }
  
  .card-hover:hover {
    animation: card-hover 0.3s ease-out forwards;
  }
</style>
  </head>
  <body class="bg-gray-50">
  <%- include('../includes/nav') %>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Welcome Section -->
      <section class="mb-12">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Radhe Krishna!</h2>
        <p class="text-lg text-gray-600">Welcome to my task. Explore and manage your properties.</p>
      </section>

      <!-- Homes Grid -->
      <section>
        <h3 class="text-2xl font-bold text-gray-900 mb-6">Your Properties</h3>
        <% if (!registeredHomes || registeredHomes.length === 0) { %>
          <div class="text-center py-12 bg-white rounded-lg border-2 border-dashed border-gray-300">
            <p class="text-gray-500 text-lg">No properties added yet.</p>
            <a href="/host/add-home" class="inline-block mt-4 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">Add your first home</a>
          </div>
        <% } else { %>
          <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% registeredHomes.forEach(element => { %>
              <li class="group card-hover bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border border-gray-100">
                <!-- Image Section -->
                <div class="relative h-56 overflow-hidden bg-linear-to-br from-red-100 to-red-50">
                  <% if (element.image) { %>
                    <img src="<%= element.image %>" alt="<%= element.homeName %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-6xl">🏠</div>
                  <% } %>
                  <!-- Badge -->
                  <div class="absolute top-4 right-4 bg-linear-to-r from-red-500 to-red-600 text-white px-4 py-2 rounded-full text-xs font-bold shadow-lg">
                    Featured
                  </div>
                </div>

                <!-- Content Section -->
                <div class="p-6">
                  <!-- Title -->
                  <h4 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-red-600 transition-colors"><%= element.homeName %></h4>
                  
                  <!-- Location -->
                  <div class="flex items-center gap-2 mb-4 text-gray-600">
                    <span class="text-lg">📍</span>
                    <p class="text-sm"><%= element.location || 'Location not specified' %></p>
                  </div>

                  <!-- Rating -->
                  <div class="flex items-center gap-3 mb-4 pb-4 border-b border-gray-200">
                    <div class="flex items-center gap-1">
                      <span class="text-yellow-400">⭐</span>
                      <span class="font-bold text-gray-900"><%= element.rating || '4.8' %></span>
                      <span class="text-gray-500 text-sm">/5</span>
                    </div>
                  </div>

                  <!-- Price Section -->
                  <div class="flex items-baseline gap-2 mb-6">
                    <span class="text-3xl font-bold text-gray-900">$<%= element.price || '99' %></span>
                    <span class="text-gray-600 text-sm">per night</span>
                  </div>

                  <!-- Features -->

                  <!-- Button -->
                  <button class="w-full py-3 px-4 bg-linear-to-r from-red-500 to-red-600 text-white font-bold rounded-lg hover:from-red-600 hover:to-red-700 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:scale-105">
                    View Details →
                  </button>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </main>

    <!-- Footer -->
    <%- include('../includes/footer') %>
  </body>
</html>
